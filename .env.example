# Nginx 配置管理平台环境变量模板
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，严禁提交到版本库。

# ---- 数据库（MySQL）----
# 使用最小权限专用账号，不要使用共享/超级账号；密码含特殊字符时注意 URL 编码
DATABASE_URL=mysql+pymysql://nginx_user:CHANGE_ME@localhost:3306/nginx_manager

# ---- JWT 密钥（必配）----
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
# 未配置或使用示例占位值时，应用会每次启动随机生成，重启后所有登录会话失效
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ---- 应用配置 ----
# 生产环境必须设为 false（DEBUG=true 会暴露调试信息）
DEBUG=false
APP_NAME=Nginx配置管理平台
APP_VERSION=1.2.0
